{
  "name": "opportunity-board",
  "version": "0.4.6",
  "private": true,
  "description": "Opportunity Knox: a private career workspace with a Docker launcher",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:launcher": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "check": "npm run build && npm test && npm run test:launcher",
    "format": "prettier --write src server tests/*.mjs vite.config.ts tsconfig.json package.json index.html"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "cheerio": "^1.2.0",
    "docx": "9.13.0",
    "ipaddr.js": "^2.5.0",
    "jszip": "3.10.1",
    "lucide-react": "^0.468.0",
    "pdf-parse": "2.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "undici": "7.30.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "fake-indexeddb": "6.2.6",
    "prettier": "3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
