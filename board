#!/bin/sh
# Host entrypoint: Docker remains behind the launcher.
set -eu
BOARD_REPO=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if ! command -v python3 >/dev/null 2>&1; then
  printf '%s\n' 'Opportunity Board needs Python 3 for its launcher. Install Python 3, then run ./board start again.' >&2
  exit 1
fi
exec python3 "$BOARD_REPO/scripts/launcher.py" "$@"
